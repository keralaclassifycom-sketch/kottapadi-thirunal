{
  "rules": {
    "visits": {
      ".read": true,
      "total": {
        ".write": "newData.isNumber() && (!data.exists() ? newData.val() == 1 : newData.val() == data.val() + 1)"
      }
    },
    "presence": {
      ".read": true,
      "$id": {
        ".write": "!newData.exists() || (newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 60000)"
      }
    },
    "test": {
      ".read": true,
      "visits": { "total": { ".write": "newData.isNumber() && (!data.exists() ? newData.val() == 1 : newData.val() == data.val() + 1)" } },
      "presence": { "$id": { ".write": "!newData.exists() || (newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 60000)" } }
    }
  }
}
